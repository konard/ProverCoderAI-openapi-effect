{
  "name": "@prover-coder-ai/openapi-effect",
  "version": "1.0.27",
  "description": "openapi-fetch-compatible client that returns Effect values",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "vibecode-linter src/",
    "lint:tests": "vibecode-linter tests/",
    "lint:effect": "eslint --config eslint.effect-ts-check.config.mjs .",
    "lint:types": "./scripts/lint-types.sh",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:consumer": "tsc -p tsconfig.build.json && tsc -p tests/consumer/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/openapi-effect.git"
  },
  "keywords": [
    "effect",
    "typescript",
    "openapi",
    "openapi-fetch"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/openapi-effect/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/openapi-effect#readme",
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "effect": "^3.21.4",
    "openapi-typescript-helpers": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@ton-ai-core/vibecode-linter": "^1.0.11",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^68.0.0",
    "globals": "^17.6.0",
    "jscpd": "^5.0.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
